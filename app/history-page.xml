<?xml version="1.0" encoding="UTF-8" ?>
<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" class="bg-gray-100">
    <ActionBar title="Historie příkazů" class="bg-blue-600 text-white">
        <NavigationButton text="Zpět" android.systemIcon="ic_menu_back" />
    </ActionBar>

    <ScrollView>
        <StackLayout class="p-4 space-y-4">
            <!-- Filtry -->
            <StackLayout class="bg-white p-4 rounded-lg shadow-md space-y-3">
                <Label text="Filtry" class="text-lg font-bold" />

                <!-- Vyhledávání -->
                <StackLayout>
                    <Label text="Hledat" class="text-sm font-medium text-gray-600" />
                    <TextField text="{{ searchText }}" hint="Zadejte hledaný text" 
                               class="p-2 bg-gray-100 rounded border-width-1 border-gray-300" />
                </StackLayout>

                <!-- Status filter -->
                <StackLayout>
                    <Label text="Stav" class="text-sm font-medium text-gray-600" />
                    <DropDown opened="{{ applyFilters }}" class="p-2 bg-gray-100 rounded border-width-1 border-gray-300">
                        <DropDown.items>
                            <DropDownItem v-for="option in statusOptions" 
                                         [value]="option.value"
                                         [text]="option.label" />
                        </DropDown.items>
                        <DropDown.selectedValue>
                            <Binding path="selectedStatus" twoWay="true" />
                        </DropDown.selectedValue>
                    </DropDown>
                </StackLayout>

                <!-- Action type filter -->
                <StackLayout>
                    <Label text="Typ akce" class="text-sm font-medium text-gray-600" />
                    <DropDown opened="{{ applyFilters }}" class="p-2 bg-gray-100 rounded border-width-1 border-gray-300">
                        <DropDown.items>
                            <DropDownItem v-for="option in actionTypeOptions" 
                                         [value]="option.value"
                                         [text]="option.label" />
                        </DropDown.items>
                        <DropDown.selectedValue>
                            <Binding path="selectedActionType" twoWay="true" />
                        </DropDown.selectedValue>
                    </DropDown>
                </StackLayout>

                <!-- Date filters -->
                <StackLayout orientation="horizontal" class="space-x-2">
                    <StackLayout class="flex-1">
                        <Label text="Od data" class="text-sm font-medium text-gray-600" />
                        <DatePicker date="{{ startDate }}" class="p-2 bg-gray-100 rounded border-width-1 border-gray-300" />
                    </StackLayout>
                    <StackLayout class="flex-1">
                        <Label text="Do data" class="text-sm font-medium text-gray-600" />
                        <DatePicker date="{{ endDate }}" class="p-2 bg-gray-100 rounded border-width-1 border-gray-300" />
                    </StackLayout>
                </StackLayout>

                <!-- Filter buttons -->
                <StackLayout orientation="horizontal" class="space-x-2">
                    <Button text="Použít filtry" tap="{{ applyFilters }}" 
                            class="flex-1 bg-blue-500 text-white font-bold p-2 rounded" />
                    <Button text="Vyčistit filtry" tap="{{ clearFilters }}" 
                            class="flex-1 bg-gray-500 text-white font-bold p-2 rounded" />
                </StackLayout>
            </StackLayout>

            <!-- Export buttons -->
            <StackLayout orientation="horizontal" class="space-x-2">
                <Button text="Exportovat CSV" tap="{{ exportHistory }}" 
                        class="flex-1 bg-green-500 text-white font-bold p-2 rounded" />
                <Button text="Exportovat JSON" tap="{{ exportHistoryJSON }}" 
                        class="flex-1 bg-green-600 text-white font-bold p-2 rounded" />
            </StackLayout>

            <!-- Clear all button -->
            <Button text="Smazat celou historii" tap="{{ clearAllHistory }}" 
                    class="bg-red-500 text-white font-bold p-2 rounded" />

            <!-- Seznam historie -->
            <Label text="Záznamy ({{ filteredHistory.length }})" class="text-lg font-bold mt-4" />

            <ListView items="{{ filteredHistory }}" class="bg-white rounded-lg">
                <ListView.itemTemplate>
                    <GridLayout columns="auto, *, auto" rows="auto, auto, auto" class="p-3 border-b border-gray-200">
                        <!-- Status indicator -->
                        <StackLayout col="0" row="0" rowspan="3" class="w-3 h-3 rounded-full m-auto {{ getStatusColor(status) }}" />

                        <!-- Main content -->
                        <StackLayout col="1" class="space-y-1">
                            <!-- Command -->
                            <Label row="0" text="{{ command }}" class="font-bold text-lg" textWrap="true" />

                            <!-- Action info -->
                            <StackLayout row="1" orientation="horizontal" class="space-x-2">
                                <Label text="{{ actionName }}" class="text-sm text-gray-600" />
                                <Label text="•" class="text-sm text-gray-400" />
                                <Label text="{{ getActionTypeText(actionType) }}" class="text-sm text-blue-500" />
                            </StackLayout>

                            <!-- Timestamp -->
                            <Label row="2" text="{{ formatDate(timestamp) }}" class="text-xs text-gray-500" />

                            <!-- Error message (if present) -->
                            <Label row="3" text="{{ errorMessage }}" 
                                   visibility="{{ errorMessage ? 'visible' : 'collapsed' }}"
                                   class="text-xs text-red-500 mt-1" textWrap="true" />
                        </StackLayout>

                        <!-- Delete button -->
                        <Button col="2" row="0" rowspan="4" text="×" tap="{{ $parent.deleteEntry }}"
                                class="bg-red-100 text-red-500 text-lg font-bold rounded-full w-8 h-8" />
                    </GridLayout>
                </ListView.itemTemplate>
                <ListView.emptyTemplate>
                    <Label text="Žádné záznamy v historii." class="text-center text-gray-500 p-4" />
                </ListView.emptyTemplate>
            </ListView>
        </StackLayout>
    </ScrollView>
</Page>
