<?xml version="1.0" encoding="UTF-8" ?>
<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" class="bg-theme-primary">
    <ActionBar title="Nastaven\u00ed" class="bg-blue-600 text-white">
        <NavigationButton text="Zp\u011bt" android.systemIcon="ic_menu_back" />
    </ActionBar>

    <ScrollView>
        <StackLayout class="p-4 space-y-4 animate-fade-in">
            <!-- Aktiva\u010dn\u00ed fr\u00e1ze -->
            <Label text="Aktiva\u010dn\u00ed fr\u00e1ze" class="text-lg font-bold text-theme-primary" />
            <GridLayout columns="*, auto" class="mb-2">
                <TextField col="0" text="{{ currentPhrase }}" hint="Zadejte novou fr\u00e1zi" 
                          class="p-2 bg-theme-secondary rounded border-theme border-width-1 text-theme-primary" />
                <Button col="1" text="P\u0159idat" tap="{{ addPhrase }}" 
                        class="ml-2 bg-blue-500 text-white font-bold rounded-lg transition-normal" />
            </GridLayout>
            
            <ListView items="{{ wakePhrases }}" class="bg-theme-secondary rounded-lg shadow-theme">
                <ListView.itemTemplate>
                    <GridLayout columns="*, auto" class="p-2 border-b border-theme">
                        <Label col="0" text="{{ $value }}" class="text-theme-primary" />
                        <Button col="1" text="Odstranit" tap="{{ $parent.removePhrase }}" 
                                class="bg-red-500 text-white text-sm rounded transition-normal" />
                    </GridLayout>
                </ListView.itemTemplate>
            </ListView>

            <!-- Zvukov\u00e1 zp\u011btn\u00e1 vazba -->
            <Label text="Zvukov\u00e1 zp\u011btn\u00e1 vazba" class="text-lg font-bold text-theme-primary mt-4" />
            <Switch checked="{{ feedbackEnabled }}" class="ml-2" />

            <!-- Citlivost rozpozn\u00e1v\u00e1n\u00ed -->
            <Label text="Citlivost rozpozn\u00e1v\u00e1n\u00ed" class="text-lg font-bold text-theme-primary mt-4" />
            <Slider value="{{ sensitivity }}" minValue="0" maxValue="1" class="ml-2" />
            <Label text="{{ sensitivity | number:'1.1' }}" class="text-center text-theme-secondary" />

            <!-- Akce -->
            <Label text="Akce" class="text-lg font-bold text-theme-primary mt-6 border-t-2 border-theme pt-4" />

            <!-- Formul\u00e1\u0159 pro p\u0159id\u00e1n\u00ed akce -->
            <StackLayout class="space-y-2 bg-theme-secondary p-3 rounded-lg shadow-theme">
                <Label text="P\u0159idat novou akci" class="font-semibold text-theme-primary" />
                <TextField text="{{ newActionName }}" hint="N\u00e1zev (nap\u0159. Sv\u011btlo v ob\u00fdv\u00e1ku)" class="p-2 bg-white rounded text-gray-800" />
                <TextField text="{{ newActionPhrase }}" hint="Spou\u0161t\u011bc\u00ed fr\u00e1ze (nap\u0159. rozsvi\u0165 sv\u011btlo)" class="p-2 bg-white rounded text-gray-800" />

                <!-- P\u0159ep\u00edna\u010d typu akce -->
                <SegmentedBar selectedIndex="{{ newActionType === 'webhook' ? 0 : 1 }}"
                              tap="{{ (args) => { newActionType = args.object.selectedIndex === 0 ? 'webhook' : 'tasker' } }}"
                              class="mt-2">
                    <SegmentedBarItem title="Webhook" />
                    <SegmentedBarItem title="Tasker" />
                </SegmentedBar>

                <!-- Pole pro URL (viditeln\u00e9 jen pro webhook) -->
                <TextField text="{{ newActionUrl }}" hint="URL adresa webhooku" autocapitalizationType="none"
                           visibility="{{ newActionType === 'webhook' ? 'visible' : 'collapsed' }}"
                           class="p-2 bg-white rounded mt-1 text-gray-800" />

                <!-- Pole pro n\u00e1zev \u00falohy (viditeln\u00e9 jen pro Tasker) -->
                <TextField text="{{ newActionTaskName }}" hint="N\u00e1zev \u00falohy v Taskeru" autocapitalizationType="none"
                           visibility="{{ newActionType === 'tasker' ? 'visible' : 'collapsed' }}"
                           class="p-2 bg-white rounded mt-1 text-gray-800" />

                <Button text="P\u0159idat akci" tap="{{ addAction }}" class="mt-2 bg-blue-500 text-white font-bold rounded-lg transition-normal" />
            </StackLayout>

            <!-- Seznam akc\u00ed -->
            <ListView items="{{ actions }}" class="bg-theme-secondary rounded-lg shadow-theme mt-4">
                <ListView.itemTemplate>
                    <GridLayout columns="*, auto" rows="auto, auto, auto" class="p-3 border-b border-theme">
                        <StackLayout row="0" col="0" orientation="horizontal">
                            <Label text="{{ name }}" class="font-bold text-lg text-theme-primary" />
                            <Label text="{{ ' (' + type + ')' }}" class="text-sm text-theme-secondary align-bottom ml-1" />
                        </StackLayout>

                        <Label row="1" col="0" text="{{ phrase }}" class="text-sm text-theme-secondary mt-1" />

                        <Label row="2" col="0" text="{{ type === 'webhook' ? url : taskName }}"
                               class="text-xs text-blue-400 mt-1" textWrap="true" />

                        <Button row="0" rowspan="3" col="1" text="Odstranit" tap="{{ $parent.removeAction }}"
                                class="bg-red-500 text-white text-sm rounded m-auto transition-normal" />
                    </GridLayout>
                </ListView.itemTemplate>
            </ListView>

            <!-- Historie p\u0159\u00edkaz\u016f -->
            <Button text="Historie p\u0159\u00edkaz\u016f" tap="{{ showHistory }}" 
                    class="bg-purple-500 text-white font-bold p-3 rounded-lg mt-6 transition-normal" />

            <!-- Statistiky -->
            <Button text="Statistiky pou\u017eit\u00ed" tap="{{ showStatistics }}" 
                    class="bg-orange-500 text-white font-bold p-3 rounded-lg transition-normal" />

            <!-- TTS Nastaven\u00ed -->
            <Label text="Hlasov\u00e1 zp\u011btn\u00e1 vazba (TTS)" class="text-lg font-bold text-theme-primary mt-6 border-t-2 border-theme pt-4" />

            <StackLayout class="bg-theme-secondary p-4 rounded-lg shadow-theme space-y-3">
                <!-- Povolit TTS -->
                <StackLayout orientation="horizontal" class="space-x-2">
                    <Switch checked="{{ ttsEnabled }}" class="mt-1" />
                    <Label text="Povolit hlasovou zp\u011btnou vazbu" class="text-theme-primary" />
                </StackLayout>

                <!-- Jazyk -->
                <StackLayout>
                    <Label text="Jazyk" class="text-sm font-medium text-theme-secondary" />
                    <DropDown selectedIndex="0" class="p-2 bg-white rounded border-theme border-width-1 text-gray-800">
                        <DropDown.items>
                            <DropDownItem v-for="lang in availableLanguages" 
                                         [value]="lang"
                                         [text]="lang" />
                        </DropDown.items>
                        <DropDown.selectedValue twoWay="true">
                            <Binding path="ttsLanguage" />
                        </DropDown.selectedValue>
                    </DropDown>
                </StackLayout>

                <!-- V\u00fd\u0161ka hlasu -->
                <StackLayout>
                    <Label text="V\u00fd\u0161ka hlasu: {{ ttsPitch | number:'1.1' }}" class="text-sm font-medium text-theme-secondary" />
                    <Slider value="{{ ttsPitch }}" minValue="0.5" maxValue="2.0" step="0.1" class="ml-2" />
                </StackLayout>

                <!-- Rychlost \u0159e\u010di -->
                <StackLayout>
                    <Label text="Rychlost \u0159e\u010di: {{ ttsRate | number:'1.1' }}" class="text-sm font-medium text-theme-secondary" />
                    <Slider value="{{ ttsRate }}" minValue="0.5" maxValue="2.0" step="0.1" class="ml-2" />
                </StackLayout>

                <!-- Test TTS -->
                <Button text="Testovat TTS" tap="{{ testTTS }}" 
                        class="bg-green-500 text-white font-bold p-2 rounded-lg transition-normal" />
            </StackLayout>

            <!-- Tmav\u00fd re\u017eim -->
            <Label text="Vzhled" class="text-lg font-bold text-theme-primary mt-6 border-t-2 border-theme pt-4" />
            <StackLayout class="bg-theme-secondary p-4 rounded-lg shadow-theme space-y-3">
                <Label text="Re\u017eim zobrazen\u00ed" class="text-sm font-medium text-theme-secondary" />
                <DropDown selectedIndex="0" class="p-2 bg-white rounded border-theme border-width-1 text-gray-800">
                    <DropDown.items>
                        <DropDownItem v-for="mode in themeModes" 
                                     [value]="mode.value"
                                     [text]="mode.label" />
                    </DropDown.items>
                    <DropDown.selectedValue twoWay="true">
                        <Binding path="currentThemeMode" />
                    </DropDown.selectedValue>
                </DropDown>
                <Label text="Aktu\u00e1ln\u001d re\u017eim: {{ currentThemeMode }}" class="text-xs text-theme-secondary" />
            </StackLayout>
        </StackLayout>
    </ScrollView>
</Page>
